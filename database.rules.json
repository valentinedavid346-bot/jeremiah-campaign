{
  "rules": {
    ".read": false,
    ".write": false,
    "supporters": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === true"
      }
    },
    "votes": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 20 && newData.val() % 1 === 0"
      }
    },
    "ideas": {
      ".read": "query.orderByChild === 'approved' && query.equalTo === true",
      ".indexOn": [
        "approved"
      ],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['text', 'approved', 'ts']) && newRoot.child('ideaTimes').child(auth.uid).val() === now",
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 200"
        },
        "approved": {
          ".validate": "newData.val() === false"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "ideaTimes": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now && (!data.exists() || now - data.val() > 60000)"
      }
    },
    "messages": {
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['topic', 'text', 'name', 'grade', 'ts']) && newRoot.child('msgTimes').child(auth.uid).val() === now",
        "topic": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 1000"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "grade": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "msgTimes": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now && (!data.exists() || now - data.val() > 30000)"
      }
    },
    "moods": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['v','d']) && newData.child('v').isNumber() && newData.child('v').val() >= 0 && newData.child('v').val() <= 4 && newData.child('v').val() % 1 === 0 && newData.child('d').isString() && newData.child('d').val().length === 10",
        "$other": {
          ".validate": false
        }
      }
    },
    "snake": {
      ".read": true,
      ".indexOn": [
        "best",
        "day"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','best','dayBest','day','ts']) && (!data.exists() || now - data.child('ts').val() > 8000)",
        "name": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9 ._-]{2,12}$/)"
        },
        "best": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000 && newData.val() % 1 === 0"
        },
        "dayBest": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('best').val() && newData.val() % 1 === 0"
        },
        "day": {
          ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
