{
  "rules": {
    ".read": false,
    ".write": false,
    "supporters": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === true"
      }
    },
    "votes": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 20 && newData.val() % 1 === 0"
      }
    },
    "ideas": {
      ".read": "query.orderByChild === 'approved' && query.equalTo === true",
      ".indexOn": [
        "approved"
      ],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['text', 'approved', 'ts']) && newRoot.child('ideaTimes').child(auth.uid).val() === now",
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 200"
        },
        "approved": {
          ".validate": "newData.val() === false"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "ideaTimes": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now && (!data.exists() || now - data.val() > 60000)"
      }
    },
    "messages": {
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['topic', 'text', 'name', 'grade', 'ts']) && newRoot.child('msgTimes').child(auth.uid).val() === now",
        "topic": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 1000"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "grade": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "msgTimes": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now && (!data.exists() || now - data.val() > 30000)"
      }
    }
  }
}