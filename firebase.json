{
  "hosting": {
    "public": "docs",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(html|js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(jpg|jpeg|png|webp|mp4)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
